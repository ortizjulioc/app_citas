// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USUARIOS Y SEGURIDAD

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  negocioId String?
  password  String
  nombre    String
  apellido  String
  telefono  String?
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificacions Notificacion[]
  negocio       Negocio?       @relation(fields: [negocioId], references: [id])
  usuarioRols   UsuarioRol[]
  empleados     Empleado[]
  pagos         Pago[]
  facturas      Factura[]

  // Sesiones que abrió
  CajaAbiertaPor SesionCaja[] @relation("CajaAbiertaPor")

  // Sesiones que cerró
  CajaCerradaPor SesionCaja[] @relation("CajaCerradaPor")

  @@map("usuario")
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  usuarioRols UsuarioRol[]
  rolPermisos RolPermiso[]

  @@map("rol")
}

model UsuarioRol {
  id        String   @id @default(uuid())
  usuarioId String
  rolId     String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  rol       Rol      @relation(fields: [rolId], references: [id])

  @@unique([usuarioId, rolId])
  @@index([usuarioId])
  @@map("usuario_rol")
}

model Permiso {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolPermisos RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  id        String   @id @default(uuid())
  rolId     String
  permisoId String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rol       Rol      @relation(fields: [rolId], references: [id])
  permiso   Permiso  @relation(fields: [permisoId], references: [id])

  @@unique([rolId, permisoId])
  @@index([rolId, permisoId])
  @@map("rol_permiso")
}

// NEGOCIO Y SUCURSALES

model Negocio {
  id                String            @id @default(uuid())
  nombre            String
  descripcion       String?
  RNC               String?
  telefono          String?
  email             String?
  direccion         String?
  categoriaServicio CategoriaServicio

  // Configuración de facturación
  facturarConItbis Boolean @default(false)
  tasaItbis        Float   @default(0.18)

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursals           Sucursal[]
  clienteNegocios     ClienteNegocio[]
  usuarios            Usuario[]
  facturas            Factura[]
  pagos               Pago[]
  metodoPagos         MetodoPago[]
  cajas               Caja[]
  sesionCajas         SesionCaja[]
  movimientoCajas     MovimientoCaja[]
  productos           Producto[]
  movimientoProductos MovimientoProducto[]
  servicios           Servicio[]
  empleados           Empleado[]
  secuenciaFactura    SecuenciaFactura?

  @@index([deleted])
  @@map("negocio")
}

model Sucursal {
  id                String             @id @default(uuid())
  nombre            String
  negocioId         String
  deleted           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  negocio           Negocio            @relation(fields: [negocioId], references: [id])
  citas             Cita[]
  facturas          Factura[]
  productos         Producto[]
  cajas             Caja[]
  empleados         Empleado[]
  horarioSucursals  HorarioSucursal[]
  servicioSucursals ServicioSucursal[]

  @@unique([negocioId, nombre])
  @@map("sucursal")
}

model HorarioSucursal {
  id         String @id @default(uuid())
  sucursalId String

  diaSemana DiaSemana

  horaInicio DateTime @db.Time
  horaFin    DateTime @db.Time

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@index([sucursalId, diaSemana])
  @@map("horarios_sucursal")
}

// CLIENTES

model Cliente {
  id              String           @id @default(uuid())
  nombre          String
  apellido        String
  telefono        String?
  email           String?
  fechaNacimiento DateTime?
  direccion       String?
  notas           String?
  deleted         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  citas           Cita[]
  facturas        Factura[]
  clienteNegocios ClienteNegocio[]

  @@index([telefono])
  @@map("cliente")
}

model ClienteNegocio {
  id        String @id @default(uuid())
  clienteId String
  negocioId String

  totalGastado Float     @default(0)
  ultimaVisita DateTime?
  notas        String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])

  createdAt DateTime @default(now())

  @@unique([clienteId, negocioId])
  @@index([negocioId])
  @@index([clienteId])
  @@map("cliente_negocio")
}

// EMPLEADOS

model Empleado {
  id                String      @id @default(uuid())
  usuarioId         String?
  sucursalId        String
  negocioId         String
  nombre            String
  apellido          String
  telefono          String
  email             String
  tipoSalario       TipoSalario
  salarioBase       Float?
  fechaContratacion DateTime?
  deleted           Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  comisionEmpleados ComisionEmpleado[]
  servicioEmpleados ServicioEmpleado[]
  citas             Cita[]
  nominas           Nomina[]
  horarioEmpleados  HorarioEmpleado[]
  usuario           Usuario?           @relation(fields: [usuarioId], references: [id])
  sucursal          Sucursal           @relation(fields: [sucursalId], references: [id])
  bloqueoHorarios   BloqueoHorario[]
  negocio           Negocio            @relation(fields: [negocioId], references: [id])

  @@index([sucursalId])
  @@index([usuarioId])
  @@map("empleado")
}

model BloqueoHorario {
  id         String   @id @default(uuid())
  empleadoId String
  inicio     DateTime
  fin        DateTime
  motivo     String?
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  empleado   Empleado @relation(fields: [empleadoId], references: [id])

  @@index([empleadoId])
  @@map("bloqueo_horario")
}

model HorarioEmpleado {
  id         String    @id @default(uuid())
  empleadoId String
  diaSemana  DiaSemana
  horaInicio DateTime  @db.Time
  horaFin    DateTime  @db.Time
  deleted    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@index([empleadoId])
  @@map("horario_empleado")
}

model ComisionEmpleado {
  id         String   @id @default(uuid())
  empleadoId String
  servicioId String
  porcentaje Float
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@index([empleadoId])
  @@index([servicioId])
  @@map("comision_empleado")
}

model Servicio {
  id              String  @id @default(uuid())
  negocioId       String
  nombre          String
  descripcion     String?
  duracionMinutos Int
  deleted         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  negocio   Negocio  @relation(fields: [negocioId], references: [id])

  comisionEmpleados ComisionEmpleado[]
  servicioEmpleados ServicioEmpleado[]
  servicioCitas     ServicioCita[]
  detalleFacturas   DetalleFactura[]
  servicioSucursals ServicioSucursal[]

  @@map("servicio")
}

model ServicioSucursal {
  id         String  @id @default(uuid())
  servicioId String
  sucursalId String
  precio     Float?
  costo      Float?
  activo     Boolean @default(true)

  servicio Servicio @relation(fields: [servicioId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([servicioId, sucursalId])
  @@index([servicioId])
  @@index([sucursalId])
  @@map("servicio_sucursal")
}

model ServicioEmpleado {
  id         String   @id @default(uuid())
  servicioId String
  empleadoId String
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  servicio Servicio @relation(fields: [servicioId], references: [id])
  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@index([servicioId])
  @@index([empleadoId])
  @@map("servicio_empleado")
}

// AGENDA/CITAS

model Cita {
  id         String     @id @default(uuid())
  clienteId  String
  empleadoId String
  sucursalId String
  inicio     DateTime
  fin        DateTime
  estado     EstadoCita
  deleted    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  empleado       Empleado        @relation(fields: [empleadoId], references: [id])
  sucursal       Sucursal        @relation(fields: [sucursalId], references: [id])
  servicioCitas  ServicioCita[]
  facturas       Factura[]
  historialCitas HistorialCita[]

  @@unique([empleadoId, inicio])
  @@index([clienteId])
  @@index([empleadoId])
  @@index([sucursalId])
  @@map("cita")
}

model HistorialCita {
  id     String     @id @default(uuid())
  citaId String
  estado EstadoCita
  fecha  DateTime   @default(now())
  nota   String?

  cita Cita @relation(fields: [citaId], references: [id])

  @@map("historial_cita")
}

model ServicioCita {
  id         String   @id @default(uuid())
  citaId     String
  servicioId String
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cita     Cita     @relation(fields: [citaId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@unique([citaId, servicioId])
  @@map("servicio_cita")
}

// FACTURACION

model SecuenciaFactura {
  negocioId    String  @id
  ultimoNumero Int     @default(0)
  negocio      Negocio @relation(fields: [negocioId], references: [id])

  @@map("secuencia_factura")
}

model Factura {
  id            String        @id @default(uuid())
  numeroFactura String
  clienteId     String
  citaId        String?
  sucursalId    String
  negocioId     String

  // Montos
  subtotal     Float
  descuentos   Float  @default(0)
  tasaItbis    Float  @default(0)  // tasa aplicada al momento de crear (snapshot)
  itbisAplicado Float @default(0)  // monto en RD$ de ITBIS
  total        Float               // subtotal - descuentos + itbisAplicado
  montoPagado  Float  @default(0)  // se actualiza con cada pago registrado

  estado    EstadoFactura
  notas     String?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  negocio         Negocio          @relation(fields: [negocioId], references: [id])
  usuario         Usuario          @relation(fields: [createdBy], references: [id])
  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  sucursal        Sucursal         @relation(fields: [sucursalId], references: [id])
  cita            Cita?            @relation(fields: [citaId], references: [id])
  detalleFacturas DetalleFactura[]
  pagos           Pago[]

  @@index([clienteId])
  @@index([citaId])
  @@index([sucursalId])
  @@index([negocioId])
  @@index([numeroFactura])
  @@map("factura")
}

model DetalleFactura {
  id          String             @id @default(uuid())
  facturaId   String
  tipo        TipoDetalleFactura // SERVICIO | PRODUCTO
  servicioId  String?            // nullable: solo si tipo = SERVICIO
  productoId  String?            // nullable: solo si tipo = PRODUCTO
  descripcion String?
  cantidad    Int
  precioUnitario Float
  descuento   Float  @default(0) // descuento por línea en RD$
  subtotal    Float              // (precioUnitario * cantidad) - descuento

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factura  Factura   @relation(fields: [facturaId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])
  producto Producto? @relation(fields: [productoId], references: [id])

  @@index([facturaId])
  @@map("detalle_factura")
}

// PAGOS

model Pago {
  id           String     @id @default(uuid())
  facturaId    String
  metodoPagoId String
  sesionCajaId String?    // a qué sesión de caja pertenece este pago
  monto        Float
  referencia   String?
  estado       EstadoPago @default(COMPLETADO)
  negocioId    String

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  negocio         Negocio         @relation(fields: [negocioId], references: [id])
  factura         Factura         @relation(fields: [facturaId], references: [id])
  metodoPago      MetodoPago      @relation(fields: [metodoPagoId], references: [id])
  sesionCaja      SesionCaja?     @relation(fields: [sesionCajaId], references: [id])
  usuario         Usuario?        @relation(fields: [createdBy], references: [id])
  movimientoCaja  MovimientoCaja? // un pago puede generar un movimiento de caja (efectivo)

  @@index([facturaId])
  @@index([sesionCajaId])
  @@map("pago")
}

model MetodoPago {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  negocioId   String
  esEfectivo  Boolean @default(false) // si true, genera MovimientoCaja automáticamente

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio         Negocio          @relation(fields: [negocioId], references: [id])
  pagos           Pago[]
  movimientoCajas MovimientoCaja[]

  @@unique([negocioId, nombre])
  @@map("metodo_pago")
}

// CAJA

model Caja {
  id         String     @id @default(uuid())
  sucursalId String
  nombre     String
  estado     EstadoCaja @default(CERRADA)
  negocioId  String

  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  negocio     Negocio      @relation(fields: [negocioId], references: [id])
  sucursal    Sucursal     @relation(fields: [sucursalId], references: [id])
  sesionCajas SesionCaja[]

  @@map("caja")
}

model SesionCaja {
  id           String  @id @default(uuid())
  cajaId       String
  abiertoPorId String?
  cerradoPorId String?
  negocioId    String

  montoApertura    Float     // efectivo con que se abre la caja
  horaApertura     DateTime

  // Campos de cierre (null mientras la sesión esté abierta)
  montoEsperado    Float?    // calculado: apertura + ingresos efectivo - gastos - retiros
  montoRealContado Float?    // lo que el cajero cuenta físicamente
  diferencia       Float?    // montoRealContado - montoEsperado (positivo=sobrante, negativo=faltante)
  horaCierre       DateTime?
  notasCierre      String?

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio   Negocio  @relation(fields: [negocioId], references: [id])
  caja      Caja     @relation(fields: [cajaId], references: [id])

  movimientoCajas MovimientoCaja[]
  pagos           Pago[]

  // quien abrió la caja
  abiertoPor Usuario? @relation("CajaAbiertaPor", fields: [abiertoPorId], references: [id])

  // quien cerró la caja
  cerradoPor Usuario? @relation("CajaCerradaPor", fields: [cerradoPorId], references: [id])

  @@map("sesion_caja")
}

model MovimientoCaja {
  id           String             @id @default(uuid())
  sesionCajaId String
  tipo         TipoMovimientoCaja
  monto        Float
  descripcion  String?
  negocioId    String

  // Trazabilidad
  pagoId       String?  @unique  // si viene de un pago (efectivo)
  metodoPagoId String?           // método de pago del movimiento

  deleted    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  negocio      Negocio     @relation(fields: [negocioId], references: [id])
  sesionCaja   SesionCaja  @relation(fields: [sesionCajaId], references: [id])
  pago         Pago?       @relation(fields: [pagoId], references: [id])
  metodoPago   MetodoPago? @relation(fields: [metodoPagoId], references: [id])

  @@index([sesionCajaId])
  @@map("movimiento_caja")
}

// PRODUCTOS

model Producto {
  id          String  @id @default(uuid())
  sucursalId  String
  nombre      String
  descripcion String?
  precio      Float
  costo       Float
  stock       Int
  negocioId   String

  deleted              Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  negocio              Negocio              @relation(fields: [negocioId], references: [id])
  sucursal             Sucursal             @relation(fields: [sucursalId], references: [id])
  movimientosProductos MovimientoProducto[]
  detalleFacturas      DetalleFactura[]

  @@index([sucursalId])
  @@map("producto")
}

model MovimientoProducto {
  id               String         @id @default(uuid())
  productoId       String
  tipo             TipoMovimiento
  cantidadAnterior Int
  cantidad         Int
  cantidadNueva    Int
  referencia       String
  negocioId        String

  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio  Negocio  @relation(fields: [negocioId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("movimiento_producto")
}

// NOMINA

model PeriodoNomina {
  id          String               @id @default(uuid())
  fechaInicio DateTime
  fechaFin    DateTime
  estado      EstadoPeriodoNomina?
  nominas     Nomina[]

  @@map("periodo_nomina")
}

model Nomina {
  id              String          @id @default(uuid())
  empleadoId      String
  periodonominaId String
  salarioBase     Float
  comision        Float
  bonos           Float?
  total           Float
  deleted         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  empleado       Empleado        @relation(fields: [empleadoId], references: [id])
  periodoNomina  PeriodoNomina   @relation(fields: [periodonominaId], references: [id])
  detalleNominas DetalleNomina[]

  @@index([empleadoId])
  @@index([periodonominaId])
  @@map("nomina")
}

model DetalleNomina {
  id          String            @id @default(uuid())
  nominaId    String
  tipo        TipoDetalleNomina
  descripcion String
  cantidad    Float

  nomina Nomina @relation(fields: [nominaId], references: [id])

  @@index([nominaId])
  @@map("detalle_nomina")
}

// NOTIFICACIONES

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String
  titulo    String
  mensaje   String
  leido     Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("notificacion")
}

// *************************************************************************************************
// ENUMS
// *************************************************************************************************

enum TipoSalario {
  FIJO
  POR_HORA
  POR_COMISION
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

enum EstadoFactura {
  PENDIENTE
  PARCIAL
  PAGADA
  CANCELADA
}

enum TipoDetalleFactura {
  SERVICIO
  PRODUCTO
}

enum EstadoPago {
  COMPLETADO
  ANULADO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  GASTO
  RETIRO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoDetalleNomina {
  INGRESO
  DEDUCCION
  AJUSTE
}

enum EstadoPeriodoNomina {
  ABIERTO
  CERRADO
  PAGADO
}

enum CategoriaServicio {
  SALUD
  BELLEZA
  AUTOMOTRIZ
  PROFESIONAL
  EDUCACION
  HOGAR
  TECNOLOGIA
  FITNESS
  OTROS
}
